---
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-500.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { withBase, absoluteUrl } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  /** Path of this page, used for the canonical URL. */
  path: string;
  /** Structured data for this page, if any. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, path, jsonLd } = Astro.props;

const canonical = absoluteUrl(path, Astro.site);
const ogImage = absoluteUrl('/og.png', Astro.site);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0d0e10" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Swap the no-js class before first paint so revealed content never flashes. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script is:inline>
      // The whole site's JavaScript: entrance reveals, and demo clips that only
      // download once they are near the viewport and never move on their own when
      // reduced motion is requested.
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        var videos = document.querySelectorAll('video[data-autoplay]');

        function attach(v) {
          if (v.dataset.attached) return;
          v.dataset.attached = '1';
          var source = document.createElement('source');
          source.src = v.dataset.src;
          source.type = 'video/mp4';
          v.innerHTML = '';
          v.appendChild(source);
          v.load();
        }

        function play(v) {
          if (reduced.matches) { v.controls = true; return; }
          v.controls = false;
          var p = v.play();
          if (p && p.catch) p.catch(function () { v.controls = true; });
        }

        function applyMotionPreference() {
          for (var i = 0; i < videos.length; i++) {
            var v = videos[i];
            if (reduced.matches) { v.pause(); v.controls = true; }
            else if (v.dataset.attached && v.dataset.inview) play(v);
          }
        }

        if (!('IntersectionObserver' in window)) {
          // No observer: load the clips and let the motion preference decide.
          for (var n = 0; n < videos.length; n++) { attach(videos[n]); videos[n].dataset.inview = '1'; }
          applyMotionPreference();
        } else {
          var videoObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                var v = entry.target;
                if (entry.isIntersecting) {
                  v.dataset.inview = '1';
                  attach(v);
                  play(v);
                } else {
                  delete v.dataset.inview;
                  v.pause();
                }
              });
            },
            { rootMargin: '300px 0px' }
          );
          for (var m = 0; m < videos.length; m++) videoObserver.observe(videos[m]);
        }

        if (reduced.addEventListener) reduced.addEventListener('change', applyMotionPreference);

        var targets = document.querySelectorAll('.reveal');
        if (reduced.matches || !('IntersectionObserver' in window)) {
          for (var j = 0; j < targets.length; j++) targets[j].classList.add('is-visible');
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );

        for (var k = 0; k < targets.length; k++) observer.observe(targets[k]);
      })();
    </script>
  </body>
</html>
