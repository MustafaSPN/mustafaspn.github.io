---
/**
 * /cv — a stable, shareable URL for the CV that forwards to the PDF.
 *
 * Written as a page rather than an `astro.config` redirect so the target goes
 * through withBase() and stays correct under a project-site base path.
 */
import { site } from '../data/site';
import { withBase } from '../lib/paths';

const target = withBase(site.cv);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CV — Mustafa Sepen</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-content: center;
        background: #0d0e10;
        color: #a8a7a3;
        font: 14px/1.6 ui-monospace, 'SF Mono', Menlo, monospace;
        text-align: center;
        padding: 24px;
      }
      a { color: #e4572e; }
    </style>
  </head>
  <body>
    <p>Opening the CV — <a href={target}>Mustafa Sepen, curriculum vitae (PDF)</a>.</p>
  </body>
</html>
