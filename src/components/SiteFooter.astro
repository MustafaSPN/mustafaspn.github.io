---
import { site } from '../data/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="shell">
    <div class="footer__top">
      <p class="footer__line">Let’s build systems that move.</p>

      <ul class="footer__links">
        <li>
          <a class="link footer__link" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {
          site.linkedin && (
            <li>
              <a class="link footer__link" href={site.linkedin} rel="me noopener noreferrer" target="_blank">
                LinkedIn<span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          )
        }
        <li>
          <a class="link footer__link" href={site.github} rel="me noopener noreferrer" target="_blank">
            GitHub<span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="link footer__link" href={withBase(site.cv)}>CV</a>
        </li>
      </ul>
    </div>

    <div class="footer__bottom">
      <p class="mono">{site.name} · {site.location}</p>
      <p class="mono">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-sunken);
    border-top: 1px solid var(--rule);
    padding-block: clamp(48px, 7vw, 104px) var(--s7);
  }

  .footer__top {
    display: grid;
    gap: var(--s7);
    padding-bottom: clamp(48px, 6vw, 88px);
  }

  .footer__line {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 16ch;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s4) var(--s7);
  }

  .footer__link {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    /* Short labels such as "CV" would otherwise be a 17px-wide target. */
    padding-inline: var(--s2);
    margin-inline: calc(var(--s2) * -1);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3) var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .footer__links { justify-content: flex-end; }
  }
</style>
