---
import { site } from '../data/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="shell">
    <div class="footer__top card">
      <div class="footer__glow" aria-hidden="true"></div>
      <div class="footer__intro">
        <p class="footer__eyebrow chip">Get in touch</p>
        <a class="button button--primary footer__cta" href={`mailto:${site.email}`}>Email me</a>
      </div>

      <ul class="footer__links">
        <li>
          <a class="link footer__link" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {
          site.linkedin && (
            <li>
              <a class="link footer__link" href={site.linkedin} rel="me noopener noreferrer" target="_blank">
                LinkedIn<span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          )
        }
        <li>
          <a class="link footer__link" href={site.github} rel="me noopener noreferrer" target="_blank">
            GitHub<span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="link footer__link" href={withBase(site.cv)}>CV</a>
        </li>
      </ul>
    </div>

    <div class="footer__bottom">
      <p class="mono">{site.name} · {site.location}</p>
      <p class="mono">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(48px, 7vw, 96px) var(--s6);
  }

  .footer__top {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--s7);
    padding: clamp(28px, 5vw, 64px);
  }

  .footer__glow {
    position: absolute;
    inset: auto -20% -60% 20%;
    height: 420px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(124, 58, 237, 0.25), transparent 70%);
    pointer-events: none;
  }

  .footer__intro { position: relative; display: grid; justify-items: start; gap: var(--s5); }

  .footer__links {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 16px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.02);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 200ms var(--ease), border-color 200ms var(--ease);
  }
  .footer__link::after { content: none; }
  .footer__link:hover, .footer__link:focus-visible { color: var(--text); border-color: var(--rule-strong); }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s3) var(--s5);
    padding-top: var(--s6);
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .footer__links { justify-content: flex-end; max-width: 420px; }
  }
</style>
