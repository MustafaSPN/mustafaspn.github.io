---
import Figure from './Figure.astro';
import type { Project, RecordVariant } from '../data/projects';
import { projectNumber } from '../data/projects';
import { pageUrl } from '../lib/paths';

interface Props {
  project: Project;
  /** Metrics shown by the `data` variant instead of photography. */
  metrics?: { value: string; unit?: string; label: string }[];
  /** Layout override chosen by the profile page. */
  variant?: RecordVariant;
  /** Display number override, so each profile numbers its own order. */
  number?: string;
}

const { project, metrics = [], variant, number } = Astro.props;
const n = number ?? projectNumber(project.slug);
const href = pageUrl(`/projects/${project.slug}`);
const v = variant ?? project.variant;
---

<article class:list={['record', `record--${v}`, project.imageRatio && 'record--own-ratio']}>
  <div class="record__head reveal">
    <span class="record__number" aria-hidden="true">{n}</span>
    <div class="record__titles">
      <h3 class="record__title">
        <a class="record__link" href={href}>
          {project.title}
          <span class="visually-hidden"> — read the case study</span>
        </a>
      </h3>
      <p class="record__subtitle">{project.subtitle}</p>
      {project.comingSoon && <p class="record__soon chip">Case study coming soon</p>}
    </div>
  </div>

  {
    project.image && (
      <div class="record__media reveal">
        <Figure
          image={project.image}
          alt={project.imageAlt ?? ''}
          video={project.video}
          zoom={!project.containImage}
          contain={project.containImage}
          position={project.imagePosition}
          ratio={v === 'feature' ? undefined : (project.imageRatio ?? '4 / 3')}
          loading={v === 'feature' ? 'eager' : 'lazy'}
          sizes={
            v === 'feature'
              ? '(min-width: 1440px) 1400px, 100vw'
              : '(min-width: 1024px) 46vw, 100vw'
          }
        />
      </div>
    )
  }

  {
    project.highlights && (
      <dl class="record__highlights reveal">
        {project.highlights.map((h) => (
          <div class="record__highlight">
            <dt class="record__highlight-term">{h.term}</dt>
            <dd class="record__highlight-value">{h.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    metrics.length > 0 && (v !== 'compact' || !project.image) && (
      <ul class="record__metrics reveal">
        {metrics.map((m) => (
          <li class="record__metric">
            <span class="record__metric-value">
              {m.value}
              {m.unit && <span class="record__metric-unit">{m.unit}</span>}
            </span>
            <span class="record__metric-label">{m.label}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class="record__body reveal">
    <p class="record__result">{project.result}</p>

    <div class="record__foot">
      <ul class="tags record__tags">
        {project.tech.map((t) => <li>{t}</li>)}
      </ul>

      <div class="record__actions">
        <span class="record__cta" aria-hidden="true">Case study</span>
        {
          project.appStoreUrl && (
            <a
              class="record__source"
              href={project.appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              App Store<span class="arrow" aria-hidden="true">↗</span>
              <span class="visually-hidden"> — {project.title} (opens in a new tab)</span>
            </a>
          )
        }
        {
          project.repo && (
            <a
              class="record__source"
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
            >
              View source<span class="arrow" aria-hidden="true">↗</span>
              <span class="visually-hidden"> for {project.title} (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .record {
    position: relative;
    display: grid;
    gap: var(--s5);
    padding: clamp(16px, 2.6vw, 32px);
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-card);
    transition: border-color 240ms var(--ease), background-color 240ms var(--ease),
      transform 240ms var(--ease);
  }

  .record:hover, .record:focus-within {
    border-color: rgba(167, 139, 250, 0.35);
    background: var(--card-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    .record:hover { transform: translateY(-2px); }
  }

  /* ---- head ---- */

  .record__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s4);
    align-items: start;
  }

  .record__number {
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 28px;
    padding-inline: 8px;
    margin-top: 0.35em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
    transition: color 240ms var(--ease), border-color 240ms var(--ease), background-color 240ms var(--ease);
  }

  .record:hover .record__number,
  .record:focus-within .record__number {
    color: var(--accent);
    border-color: rgba(167, 139, 250, 0.4);
    background: var(--accent-wash);
  }

  .record__title {
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.05;
    font-size: clamp(1.6rem, 3.8vw, 2.6rem);
  }

  /* The whole record is one click target; the source link sits above it. */
  .record__link { text-decoration: none; color: var(--text); }

  .record__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .record__subtitle {
    margin-top: var(--s2);
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .record__soon { margin-top: var(--s3); color: var(--accent); }

  /* ---- body ---- */

  .record__result {
    color: var(--text-secondary);
    font-size: var(--fs-lead);
    line-height: 1.55;
    max-width: 60ch;
  }

  .record__foot {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s5);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }

  .record__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s5);
  }

  .record__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding-inline: 16px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.06);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    transition: background-color 240ms var(--ease), color 240ms var(--ease);
  }

  .record__cta::after {
    content: '→';
    transition: transform 240ms var(--ease);
  }

  .record:hover .record__cta,
  .record:focus-within .record__cta { background: var(--accent-strong); color: #fff; }
  .record:hover .record__cta::after { transform: translateX(3px); }

  .record__source {
    position: relative;
    z-index: 2;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color 200ms var(--ease);
  }

  .record__source:hover, .record__source:focus-visible { color: var(--text); }

  /* ---- metrics (data variant) ---- */

  .record__metrics {
    display: grid;
    gap: var(--s3);
  }

  .record__metric {
    display: grid;
    gap: var(--s2);
    padding: var(--s5);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: linear-gradient(180deg, rgba(167, 139, 250, 0.08), rgba(167, 139, 250, 0.01));
  }

  .record__metric-value {
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 0.14em;
  }

  .record__metric-unit {
    font-family: var(--font-mono);
    font-size: 0.3em;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .record__metric-label {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.5;
    max-width: 26ch;
  }

  /* ---- highlights (a record with no usable still) ---- */

  .record__highlights {
    display: grid;
    gap: var(--s2);
  }

  .record__highlight {
    display: grid;
    gap: var(--s1);
    padding: var(--s4);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.02);
  }

  .record__highlight-term {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .record__highlight-value {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* ---- compact ---- */

  .record--compact .record__title { font-size: clamp(1.35rem, 2.4vw, 1.75rem); }
  /* head · media/metrics · body; the body takes the spare height so the footer
     lines up across cards in the same grid row. */
  .record--compact { grid-template-rows: auto auto 1fr; }
  .record--compact .record__body { display: flex; flex-direction: column; }
  .record--compact .record__foot { margin-top: auto; }
  .record--compact .record__result { margin-bottom: var(--s5); }
  .record--compact .record__result { font-size: var(--fs-body); max-width: 46ch; }
  /* Compact cards stack the metrics as rows, like highlights, so a project with
     no photograph still fills its card. */
  .record--compact .record__metrics { grid-template-columns: 1fr !important; gap: var(--s2); }
  .record--compact .record__metric {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s4);
    padding: var(--s4);
  }
  .record--compact .record__metric-value { font-size: clamp(1.6rem, 3vw, 2.1rem); min-width: 4.2ch; }

  /* ================= breakpoints ================= */

  /* Mobile is designed, not shrunk: the flagship photograph runs edge to edge and
     is cropped taller, so the vehicle stays large on a phone. */
  @media (max-width: 699px) {
    .record--feature .record__media :global(.media) { aspect-ratio: 4 / 3; }

    /* Records with their own ratio (screenshot montages) keep it, so nothing is cropped. */
    .record--split:not(.record--own-ratio) .record__media :global(.media),
    .record--compact:not(.record--own-ratio) .record__media :global(.media) { aspect-ratio: 4 / 3; }
  }

  @media (min-width: 700px) {
    .record__metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); }
    .record__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--s6);
    }
    .record__actions { justify-content: flex-end; }
  }

  @media (min-width: 1024px) {
    .record { gap: var(--s6); }

    .record__head { grid-template-columns: 64px minmax(0, 1fr); }

    /* feature — the media leads, full width, with the text beneath it */
    .record--feature .record__body {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: var(--s4);
    }
    .record--feature .record__body > * { grid-column: 2; }

    /* split — media beside the text */
    .record--split {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      grid-template-areas:
        'head  head'
        'media body';
      column-gap: clamp(32px, 4vw, 72px);
      align-items: stretch;
    }
    .record--split .record__head { grid-area: head; }
    .record--split .record__media { grid-area: media; }
    .record--split .record__body { grid-area: body; }
    .record--split .record__body { display: flex; flex-direction: column; height: 100%; }
    .record--split .record__foot { grid-template-columns: 1fr; align-items: start; margin-top: auto; }
    .record--split .record__actions { justify-content: flex-start; }

    /* data — metrics beside the description */
    .record--data .record__body {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      gap: var(--s4);
    }
    .record--data .record__body > * { grid-column: 2; }

    /* compact — the two secondary projects sit side by side in a grid */
    .record--compact { gap: var(--s5); }
    .record--compact .record__head { grid-template-columns: auto minmax(0, 1fr); }
  }
</style>
