---
interface Props {
  href: string;
  /** A link that is the whole of its paragraph, rather than inline in a sentence.
      Standalone links get a full touch-height hit box. */
  standalone?: boolean;
  class?: string;
}

const { href, standalone = false, class: className } = Astro.props;
---

<a
  class:list={['link', standalone && 'link--standalone', className]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot /><span class="arrow" aria-hidden="true">↗</span>
  <span class="visually-hidden"> (opens in a new tab)</span>
</a>

<style>
  .link--standalone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
