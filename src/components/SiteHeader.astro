---
import { site, nav } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  role?: string;
  home?: string;
}

const { role = site.role, home = '' } = Astro.props;
---

<header class="header">
  <div class="shell header__inner">
    <a class="header__mark" href={withBase('/')}>
      <span class="header__name">Mustafa Sepen</span>
      <span class="header__role">{role}</span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__list">
        {
          nav.map((item) => (
            <li class:list={['header__item', !item.primaryMobile && 'header__item--wide']}>
              <a class="header__link" href={withBase(`${home}${item.href}`)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="header__sep" aria-hidden="true"></span>

      <ul class="header__list header__list--external">
        <li class="header__item header__item--wide">
          <a class="header__link" href={site.github} rel="me noopener noreferrer" target="_blank">
            GitHub
          </a>
        </li>
        {
          site.linkedin && (
            <li class="header__item header__item--wide">
              <a class="header__link" href={site.linkedin} rel="me noopener noreferrer" target="_blank">
                LinkedIn
              </a>
            </li>
          )
        }
        <li class="header__item">
          <a class="header__link header__link--cv" href={withBase(site.cv)}>CV</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9, 9, 11, 0.72);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--rule);
  }

  .header__inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
  }

  .header__mark {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-width: 0;
    min-height: 44px;
  }

  .header__name {
    font-weight: 650;
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
    color: var(--text);
    white-space: nowrap;
  }

  .header__role {
    display: none;
    font-size: var(--fs-small);
    color: var(--text-muted);
    white-space: nowrap;
    padding-left: var(--s3);
    border-left: 1px solid var(--rule-strong);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header__list:not(.header__list--external) {
    padding: 4px;
    border: 1px solid var(--rule);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.02);
  }

  .header__sep { display: none; }

  /* Secondary items are hidden on small screens; they remain reachable from the
     footer, which needs no JavaScript and no hamburger. */
  .header__item--wide { display: none; }

  .header__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    min-width: 44px;
    padding-inline: 14px;
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms var(--ease), background-color 200ms var(--ease);
  }

  .header__link:hover, .header__link:focus-visible {
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
  }

  .header__link--cv {
    color: #fff;
    background: var(--accent-strong);
    min-height: 40px;
  }
  .header__link--cv:hover, .header__link--cv:focus-visible { background: #6d28d9; color: #fff; }

  @media (min-width: 768px) {
    .header__item--wide { display: block; }
  }

  @media (min-width: 1100px) {
    .header__role { display: block; }
  }
</style>
